    {
      "id": "code_body",
      "type": "text",
      "x": 35,
      "y": 808,
      "width": 600,
      "height": 90,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 700702,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "let config = load_config()?;           // Phase 1 - JSON\nlet stages = load_stages()?;           // Phase 2 - JSON\nlet system = load_system()?;           // Phase 3 - JSON (buses, lines, hydros, thermals)\nlet scenarios = load_scenarios()?;     // Phase 4 - Parquet\nlet constraints = load_constraints()?; // Phase 4 - Parquet\nlet case_data = CaseData { config, stages, system, scenarios, constraints, .. };\ncase_data.canonicalize();              // Phase 6 - Sort by ID",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "let config = load_config()?;           // Phase 1 - JSON\nlet stages = load_stages()?;           // Phase 2 - JSON\nlet system = load_system()?;           // Phase 3 - JSON (buses, lines, hydros, thermals)\nlet scenarios = load_scenarios()?;     // Phase 4 - Parquet\nlet constraints = load_constraints()?; // Phase 4 - Parquet\nlet case_data = CaseData { config, stages, system, scenarios, constraints, .. };\ncase_data.canonicalize();              // Phase 6 - Sort by ID",
      "lineHeight": 1.25
    }
