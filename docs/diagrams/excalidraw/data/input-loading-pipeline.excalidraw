      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "Design Rationale",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design Rationale",
      "lineHeight": 1.25
    },
    {
      "id": "design_note_body",
      "type": "text",
      "x": 1175,
      "y": 636,
      "width": 390,
      "height": 110,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 700602,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "1. Minimizes filesystem contention on parallel FS\n2. Centralizes validation logic on one rank\n3. Reduces error handling complexity across ranks\n4. Canonicalization ensures deterministic ordering\n   regardless of input file declaration order\n5. bincode serialization for efficient MPI transfer\n6. Single broadcast avoids N-1 redundant reads",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Minimizes filesystem contention on parallel FS\n2. Centralizes validation logic on one rank\n3. Reduces error handling complexity across ranks\n4. Canonicalization ensures deterministic ordering\n   regardless of input file declaration order\n5. bincode serialization for efficient MPI transfer\n6. Single broadcast avoids N-1 redundant reads",
      "lineHeight": 1.25
    },

