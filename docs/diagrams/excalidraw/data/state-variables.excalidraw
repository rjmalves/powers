    {
      "id": "insight_body",
      "type": "text",
      "x": 640,
      "y": 718,
      "width": 340,
      "height": 112,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0.5,
      "opacity": 100,
      "seed": 500113,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "AR lag variables account for >90% of state,\nbut most carry near-zero coefficients in\npractice. This motivates:\n\n  1. Sparse cut storage (CSR format)\n  2. Cut coefficient compression\n  3. Selecting lower AR orders when possible\n  4. State aggregation / dimension reduction",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AR lag variables account for >90% of state,\nbut most carry near-zero coefficients in\npractice. This motivates:\n\n  1. Sparse cut storage (CSR format)\n  2. Cut coefficient compression\n  3. Selecting lower AR orders when possible\n  4. State aggregation / dimension reduction",
      "lineHeight": 1.25
    },

