    {
      "id": "meaning_body",
      "type": "text",
      "x": 385,
      "y": 495,
      "width": 250,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0.5,
      "opacity": 100,
      "seed": 500093,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "• Carry info between stages\n• Each cut has β coeff per state\n• θ ≥ α + β'x (Benders cut)\n• Cut coeff size = N_state × f64\n• Larger N → more memory & I/O\n• AR order is the key lever",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Carry info between stages\n• Each cut has β coeff per state\n• θ ≥ α + β'x (Benders cut)\n• Cut coeff size = N_state × f64\n• Larger N → more memory & I/O\n• AR order is the key lever",
      "lineHeight": 1.25
    },

