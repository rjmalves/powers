    },
    {
      "id": "design-goals-text",
      "type": "text",
      "x": 50,
      "y": 965,
      "width": 1120,
      "height": 55,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0.5,
      "opacity": 100,
      "seed": 600802,
      "version": 1,
      "versionNonce": 600802,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "1. Separation of Concerns: Static system data vs dynamic algorithm data vs stochastic data\n2. Scalability: File formats that scale to production sizes without memory explosion\n3. Reproducibility: All inputs deterministically produce same outputs   4. Warm-start: Efficient serialization/deserialization\n5. Distributed I/O: Rank 0 loads, broadcasts to workers",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "1. Separation of Concerns: Static system data vs dynamic algorithm data vs stochastic data\n2. Scalability: File formats that scale to production sizes without memory explosion\n3. Reproducibility: All inputs deterministically produce same outputs   4. Warm-start: Efficient serialization/deserialization\n5. Distributed I/O: Rank 0 loads, broadcasts to workers",
      "lineHeight": 1.25
    },

