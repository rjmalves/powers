    {
      "id": "par-eq2",
      "type": "text",
      "x": 1115,
      "y": 382,
      "width": 260,
      "height": 36,
      "text": "$$\\begin{gathered}a_h = \\mu_m + \\sum \\psi \\cdot (a_{\\text{lag}} - \\mu_{\\text{lag}})\\\\\\quad + \\sigma_m \\cdot \\epsilon\\end{gathered}$$",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 30,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 7005003,
      "version": 2,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "versionNonce": 1136368392,
      "index": "b0j",
      "strokeStyle": "solid",
      "angle": 0,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "updated": 1770643817489,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a_h = mu_m + Sum psi*(a_lag - mu_lag)\n       + sigma_m * epsilon",
      "autoResize": true,
      "lineHeight": 1.5
    },
