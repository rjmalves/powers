    {"id":"par-eq1","type":"text","x":1115,"y":358,"width":250,"height":18,"text":"epsilon_t ~ N(0, 1)","fontSize":13,"fontFamily":1,"textAlign":"left","baseline":14,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"seed":7005002,"version":1,"isDeleted":false,"boundElements":null,"link":null,"locked":false},
    {"id":"par-eq2","type":"text","x":1115,"y":382,"width":260,"height":36,"text":"a_h = mu_m + Sum psi*(a_lag - mu_lag)\n       + sigma_m * epsilon","fontSize":12,"fontFamily":1,"textAlign":"left","baseline":30,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"seed":7005003,"version":1,"isDeleted":false,"boundElements":null,"link":null,"locked":false},
