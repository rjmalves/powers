    {"id":"cut-formula-title","type":"text","x":60,"y":618,"width":200,"height":18,"text":"Cut Aggregation (Single-Cut)","fontSize":13,"fontFamily":1,"textAlign":"left","baseline":14,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"seed":7008001,"version":1,"isDeleted":false,"boundElements":null,"link":null,"locked":false},
    {"id":"cut-formula","type":"text","x":60,"y":640,"width":1000,"height":32,"text":"beta_bar = Sum_{omega} p(omega) * pi_t(omega)      alpha_bar = Sum_{omega} p(omega) * (Q_t - beta(omega)' * x_hat)      =>  theta_{t-1} >= alpha_bar + beta_bar' * x_{t-1}","fontSize":12,"fontFamily":1,"textAlign":"left","baseline":28,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"seed":7008002,"version":1,"isDeleted":false,"boundElements":null,"link":null,"locked":false},


