    {"id":"legend-content2","type":"text","x":1115,"y":522,"width":260,"height":70,"text":"Blue rect   = SDDP stages (decision nodes)\nCyan ellipse = Scenario realizations omega_t\nGreen arrow  = Forward: sampled scenario\nOrange arrow = Backward: all 20 evaluated\nRed arrow    = Cut propagation (backward)","fontSize":10,"fontFamily":1,"textAlign":"left","baseline":60,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":1,"opacity":100,"seed":7006002,"version":1,"isDeleted":false,"boundElements":null,"link":null,"locked":false},


