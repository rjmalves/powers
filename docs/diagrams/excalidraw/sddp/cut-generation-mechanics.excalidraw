      "type": "text",
      "x": 1185,
      "y": 477,
      "width": 300,
      "height": 18,
      "text": "INTERCEPT COMPUTATION (expanded)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 14,
      "strokeColor": "#fd7e14",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
