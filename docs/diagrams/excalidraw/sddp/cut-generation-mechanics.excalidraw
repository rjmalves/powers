    {
      "id": "detail-constraint-title",
      "type": "text",
      "x": 785,
      "y": 477,
      "width": 350,
      "height": 18,
      "text": "LP CONSTRAINT FORMS (state on RHS)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 14,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 6010301,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false
    },
    {
      "id": "detail-constraint-wb",
      "type": "text",
      "x": 785,
      "y": 500,
      "width": 350,
      "height": 30,
      "text": "$$\\begin{gathered}\\text{Water balance: } v_h - \\zeta \\cdot (\\text{flows}) = \\hat{v}_h\\\\\\rightarrow \\text{dual }\\pi^{\\text{wb}}_h = \\partial Q^*/\\partial \\hat{v}_h \\;\\; (\\$/\\text{hm}^3)\\end{gathered}$$",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 24,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 6010302,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false
    },
    {
      "id": "detail-constraint-lag",
      "type": "text",
      "x": 785,
      "y": 535,
      "width": 350,
      "height": 30,
      "text": "$$\\begin{gathered}\\text{AR lag fixing: } a_{h,l} = \\hat{a}_{h,l}\\\\\\rightarrow \\text{dual }\\pi^{\\text{lag}}_{h,l} = \\partial Q^*/\\partial \\hat{a}_{h,l} \\;\\; (\\$/(\\text{m}^3/\\text{s}))\\end{gathered}$$",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 24,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
