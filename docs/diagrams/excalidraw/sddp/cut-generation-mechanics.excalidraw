    },
    {
      "id": "detail-intercept-formula",
      "type": "text",
      "x": 1185,
      "y": 502,
      "width": 350,
      "height": 72,
      "text": "$$\\begin{gathered}\\alpha_t = Q_t(\\hat{x}_{t-1}, \\omega_t)\\\\\\quad - \\sum_h \\beta^v_{t,h} \\cdot \\hat{v}_h\\\\\\quad - \\sum_{h,l} \\beta^{\\text{lag}}_{t,h,l} \\cdot \\hat{a}_{h,l}\\\\[6pt]\\text{Ensures cut is tight at the trial point:}\\\\\\alpha + \\beta^\\top \\cdot \\hat{x} = Q_t(\\hat{x}, \\omega) \\text{ exactly}\\end{gathered}$$",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 66,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 6010312,
