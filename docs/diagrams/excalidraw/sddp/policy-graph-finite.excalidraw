    {
      "id": "bellman-eq",
      "type": "text",
      "x": 530,
      "y": 420,
      "width": 360,
      "height": 70,
      "text": "Vₜ(x_{t-1}) = 𝔼_{ωₜ}[min{cₜ'xₜ + V_{t+1}(xₜ)}]\n\nwhere x₀ = x̄₀ (given initial state)\nand V_{T+1}(x) = 0 (terminal condition)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 60,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
