    {
      "id": "legend-text",
      "type": "text",
      "x": 322.91015625,
      "y": 285.80078125,
      "width": 380,
      "height": 75,
      "text": "$$\\begin{gathered}\\bullet \\text{ Blue boxes = SDDP stages (decision nodes)}\\\\\\bullet \\text{ Yellow box = Final stage (}t = T\\text{)}\\\\\\bullet \\text{ Dashed gray = Terminal node }V_{T}(x) = 0\\\\\\bullet \\text{ Cyan ellipses = Stochastic realizations }\\omega_t\\\\\\bullet \\text{ Arrows = Stage transitions with probabilities}\\end{gathered}$$",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 65,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 191919191,
      "version": 172,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "versionNonce": 479368619,
      "index": "aO",
      "strokeStyle": "solid",
      "angle": 0,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "updated": 1770658958441,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "$$\\begin{gathered}\\bullet \\text{ Blue boxes = SDDP stages (decision nodes)}\\\\\\bullet \\text{ Yellow box = Final stage (}t = T\\text{)}\\\\\\bullet \\text{ Dashed gray = Terminal node }V_{T}(x) = 0\\\\\\bullet \\text{ Cyan ellipses = Stochastic realizations }\\omega_t\\\\\\bullet \\text{ Arrows = Stage transitions with probabilities}\\end{gathered}$$",
      "autoResize": true,
      "lineHeight": 6.25
    },
