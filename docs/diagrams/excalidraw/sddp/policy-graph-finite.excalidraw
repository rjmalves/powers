    {
      "id": "bellman-eq",
      "type": "text",
      "x": 755.91015625,
      "y": 284.80078125,
      "width": 360,
      "height": 70,
      "text": "$$\\begin{gathered}V_t(x_{t}) = \\mathbb{E}_{\\omega_t}\\!\\left[\\min\\{c_t^\\top x_t + V_{t+1}(x_{t+1})\\}\\right]\\\\[4pt]\\text{where } V_{T}(x) = 0 \\text{ (terminal condition)}\\end{gathered}$$",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 60,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 222222224,
      "version": 179,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "versionNonce": 1556206923,
      "index": "aR",
      "strokeStyle": "solid",
      "angle": 0,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "updated": 1770658807381,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "$$\\begin{gathered}V_t(x_{t-1}) = \\mathbb{E}_{\\omega_t}\\!\\left[\\min\\{c_t^\\top x_t + V_{t+1}(x_t)\\}\\right]\\\\[4pt]\\text{where } V_{T}(x) = 0 \\text{ (terminal condition)}\\end{gathered}$$",
      "autoResize": true,
      "lineHeight": 5.833333333333333
    },
