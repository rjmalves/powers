    {
      "id": "bp-lower-bound-box",
      "type": "rectangle",
      "x": 640,
      "y": 378,
      "width": 320,
      "height": 50,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#d3f9d8",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
