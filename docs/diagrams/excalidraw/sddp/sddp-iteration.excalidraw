    },
    {
      "id": "eq-title",
      "type": "text",
      "x": 75,
      "y": 711.1379006542164,
      "width": 250,
      "height": 20,
      "text": "CONVERGENCE EQUATIONS",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 16,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 3010141,
      "version": 37,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "versionNonce": 339286392,
      "index": "b0N",
      "strokeStyle": "solid",
      "angle": 0,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "updated": 1770641979722,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CONVERGENCE EQUATIONS",
      "autoResize": true,
      "lineHeight": 1.4285714285714286
    },
    {
      "id": "eq-text",
      "type": "text",
      "x": 75,
      "y": 735.1379006542164,
      "width": 460,
      "height": 80,
      "text": "$$\\begin{gathered}\\text{Lower bound: }\\underline{z}^k = V_1^k(x_0) \\quad \\text{(monotone }\\uparrow\\text{, deterministic)}\\\\\\text{Upper bound: }\\bar{z}^k = (1/M) \\sum_m \\sum_t c_t^\\top x_t^m \\quad \\text{(statistical estimate)}\\\\\\text{Gap: gap}^k = (\\bar{z}^k - \\underline{z}^k) / \\max(1, |\\bar{z}^k|) < \\varepsilon\\\\\\text{Stop when: gap}^k < \\varepsilon \\text{ or } k > k_{\\max} \\text{ or time} > t_{\\max}\\end{gathered}$$",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 74,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 3010142,
      "version": 37,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "versionNonce": 1506224760,
      "index": "b0O",
      "strokeStyle": "solid",
      "angle": 0,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "updated": 1770641979722,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lower bound:  z̲ᵏ = V₁ᵏ(x₀)                  (monotone ↑, deterministic)\nUpper bound:  z̄ᵏ = (1/M) Σₘ Σₜ cₜᵀxₜᵐ       (statistical estimate)\nGap:  gapᵏ = (z̄ᵏ − z̲ᵏ) / max(1, |z̄ᵏ|) < ε\nStop when:  gapᵏ < ε  or  k > k_max  or  time > t_max",
      "autoResize": true,
      "lineHeight": 1.8181818181818181
    },
