      "type": "text",
      "x": 650,
      "y": 127,
      "width": 300,
      "height": 36,
      "text": "$$\\begin{gathered}\\text{compute upper bound:}\\\\\\bar{z}^k = (1/M) \\sum_m \\sum_t c_t^\\top x_t^m\\end{gathered}$$",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "baseline": 30,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 3010046,
      "version": 2,
      "isDeleted": false,
      "boundElements": [],
      "containerId": "fp-upper-bound-box",
      "link": null,
      "locked": false,
      "versionNonce": 1235024504,
      "index": "af",
      "strokeStyle": "solid",
      "angle": 0,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "updated": 1770640516722,
      "verticalAlign": "top",
      "originalText": "compute upper bound:\nz̄ᵏ = (1/M) Σₘ Σₜ cₜᵀxₜᵐ",
      "autoResize": true,
      "lineHeight": 1.5
    },
