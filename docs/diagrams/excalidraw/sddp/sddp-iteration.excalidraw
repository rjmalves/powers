    {
      "id": "legend-title",
      "type": "text",
      "x": 585,
      "y": 711.1379006542164,
      "width": 100,
      "height": 20,
      "text": "LEGEND",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 16,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
