    },
    {
      "id": "legend-text",
      "type": "text",
      "x": 585,
      "y": 735.1379006542164,
      "width": 370,
      "height": 80,
      "text": "$$\\begin{gathered}\\circ \\;= \\text{ stage LP solve (one per stage per scenario)}\\\\\\to \\;= \\text{ forward simulation (sample }\\omega_t\\text{, solve, advance)}\\\\\\leftarrow \\;= \\text{ backward cut generation (extract duals, add cut)}\\\\\\diamond \\;= \\text{ convergence check (gap test)}\\\\\\dashrightarrow \\;= \\text{ next iteration loop (dashed red, }k \\leftarrow k+1\\text{)}\\end{gathered}$$",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 74,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 3010132,
      "version": 37,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "versionNonce": 130979704,
      "index": "b0L",
      "strokeStyle": "solid",
      "angle": 0,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "updated": 1770641979722,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "○  =  stage LP solve (one per stage per scenario)\n→  =  forward simulation (sample ωₜ, solve, advance)\n←  =  backward cut generation (extract duals, add cut)\n◇  =  convergence check (gap test)\n- - →  =  next iteration loop (dashed red, k ← k+1)",
      "autoResize": true,
      "lineHeight": 1.4545454545454546
    },
    {
      "id": "eq-box",
      "type": "rectangle",
      "x": 60,
      "y": 705.1379006542164,
      "width": 490,
      "height": 120,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "seed": 3010140,
