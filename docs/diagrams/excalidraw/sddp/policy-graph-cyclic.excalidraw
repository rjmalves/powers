    {
      "id": "math-title",
      "type": "text",
      "x": 510,
      "y": 290,
      "width": 200,
      "height": 20,
      "text": "CYCLIC BELLMAN EQUATION",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 16,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 161616161,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false
    },
    {
      "id": "math-eq",
      "type": "text",
      "x": 510,
      "y": 320,
      "width": 320,
      "height": 100,
      "text": "V_{12}(x) = 𝔼[min{c₁₂'x₁₂ + β·V₁(x₁₂)}]\n\nwhere:\n  β ∈ (0, 1) = discount factor\n  V₁ appears on RHS of V_{12} (cycle!)\n  Solved via fixed-point iteration",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 90,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 171717171,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false
    },
