    {
      "id": "legend-text",
      "type": "text",
      "x": 110,
      "y": 315,
      "width": 360,
      "height": 100,
      "text": "• Blue boxes = Monthly stages (12 months/year)\n• Red box = Cycle endpoint (December)\n• Dashed red arrow = Cycle back with discount\n• β < 1 ensures convergence (typically β ≈ 0.95)\n• No terminal node: infinite planning horizon\n• Seasonality captured through monthly resolution",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 90,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 141414141,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false
    },
