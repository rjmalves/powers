    {
      "id": "legend-text",
      "type": "text",
      "x": 110,
      "y": 357,
      "width": 360,
      "height": 100,
      "text": "$$\\begin{gathered}\\bullet \\text{ Blue boxes = Monthly stages (12 months/year)}\\\\\\bullet \\text{ Red box = Cycle endpoint (December)}\\\\\\bullet \\text{ Dashed red arrow = Cycle back with discount}\\\\\\bullet \\;\\beta < 1 \\text{ ensures convergence (typically }\\beta \\approx 0.95\\text{)}\\\\\\bullet \\text{ No terminal node: infinite planning horizon}\\\\\\bullet \\text{ Seasonality captured through monthly resolution}\\end{gathered}$$",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 90,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "seed": 141414141,
      "version": 44,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "versionNonce": 1345684357,
      "index": "aJ",
      "strokeStyle": "solid",
      "angle": 0,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "updated": 1770665914863,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "$$\\begin{gathered}\\bullet \\text{ Blue boxes = Monthly stages (12 months/year)}\\\\\\bullet \\text{ Red box = Cycle endpoint (December)}\\\\\\bullet \\text{ Dashed red arrow = Cycle back with discount}\\\\\\bullet \\;\\beta < 1 \\text{ ensures convergence (typically }\\beta \\approx 0.95\\text{)}\\\\\\bullet \\text{ No terminal node: infinite planning horizon}\\\\\\bullet \\text{ Seasonality captured through monthly resolution}\\end{gathered}$$",
      "autoResize": true,
      "lineHeight": 8.333333333333334
    },
