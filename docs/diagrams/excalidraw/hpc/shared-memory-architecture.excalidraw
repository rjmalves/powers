      "type": "text",
      "x": 1140,
      "y": 278,
      "width": 420,
      "height": 18,
      "text": "Synchronization Protocol (per iteration):",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 14,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
