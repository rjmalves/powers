    {
      "id": "legend-key-text",
      "type": "text",
      "x": 590,
      "y": 865,
      "width": 440,
      "height": 58,
      "text": "Key: Rust never calls OpenMP directly — all parallelism\ngoes through the C wrapper layer which holds the #pragma\ndirectives. This is required because Rust has no native\nOpenMP support; pragmas only exist in C/C++/Fortran.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "baseline": 54,
