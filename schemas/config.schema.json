{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/rjmalves/powers/schemas/config.schema.json",
    "title": "SDDP Configuration",
    "description": "Configuration parameters for SDDP algorithm execution",
    "type": "object",
    "required": [
        "num_iterations",
        "num_forward_passes",
        "seed"
    ],
    "properties": {
        "num_iterations": {
            "type": "integer",
            "description": "Number of SDDP training iterations",
            "minimum": 1,
            "examples": [
                10,
                32,
                100
            ]
        },
        "num_forward_passes": {
            "type": "integer",
            "description": "Number of forward passes per iteration for Monte Carlo sampling",
            "minimum": 1,
            "examples": [
                4,
                10,
                20
            ]
        },
        "num_simulation_scenarios": {
            "type": [
                "integer",
                "null"
            ],
            "description": "Number of scenarios for out-of-sample simulation. Set to null or omit to skip simulation (training-only mode).",
            "minimum": 1,
            "examples": [
                100,
                128,
                1000,
                null
            ]
        },
        "seed": {
            "type": "integer",
            "description": "Random seed for reproducibility (any unsigned 64-bit integer)",
            "minimum": 0,
            "examples": [
                0,
                42,
                123456
            ]
        },
        "num_threads": {
            "type": [
                "integer",
                "null"
            ],
            "description": "Number of threads for parallel execution. If null or omitted, auto-detects available cores. Recommended: 4 for small problems, 8-16 for large problems. Avoid over-subscription (threads > physical cores).",
            "minimum": 1,
            "examples": [
                4,
                8,
                null
            ]
        },
        "output_path": {
            "type": [
                "string",
                "null"
            ],
            "description": "Optional path for CSV output files. If null or omitted, no output is generated (faster execution, useful for tests)",
            "examples": [
                "./output",
                "./example",
                null
            ]
        },
        "enable_cut_selection": {
            "type": [
                "boolean",
                "null"
            ],
            "description": "Enable or disable cut selection during training. If null or omitted, defaults to false.",
            "examples": [
                true,
                false,
                null
            ]
        },
        "export_training_noises": {
            "type": [
                "boolean",
                "null"
            ],
            "description": "Enable or disable exporting of sampled noises during training. If null or omitted, defaults to false.",
            "examples": [
                true,
                false,
                null
            ]
        },
        "export_forward_detail": {
            "type": [
                "boolean",
                "null"
            ],
            "description": "Enable or disable exporting of forward pass details. If null or omitted, defaults to false.",
            "examples": [
                true,
                false,
                null
            ]
        },
        "export_backward_detail": {
            "type": [
                "boolean",
                "null"
            ],
            "description": "Enable or disable exporting of backward pass details. If null or omitted, defaults to false.",
            "examples": [
                true,
                false,
                null
            ]
        },
        "output": {
            "type": "object",
            "description": "Structured output configuration. All outputs use indexed format with integer indices instead of variable names. Requires dictionary files for decoding.",
            "properties": {
                "path": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Directory path for output files. If null, uses the root output_path field.",
                    "examples": [
                        "./output",
                        "./results"
                    ]
                },
                "format": {
                    "type": "string",
                    "description": "Output file format. CSV is human-readable text (default). PARQUET is columnar binary with 70-80% compression. Auto selects based on data size.",
                    "enum": [
                        "CSV",
                        "PARQUET",
                        "Auto"
                    ],
                    "default": "CSV",
                    "examples": [
                        "CSV",
                        "PARQUET",
                        "Auto"
                    ]
                },
                "export_training": {
                    "type": "boolean",
                    "description": "Export training convergence results (training.csv). Default: true",
                    "default": true,
                    "examples": [
                        true,
                        false
                    ]
                },
                "export_cuts": {
                    "type": "boolean",
                    "description": "Export Benders cuts with coefficient indices (cuts.csv). Requires coefficient_dictionary.csv for decoding. Default: true",
                    "default": true,
                    "examples": [
                        true,
                        false
                    ]
                },
                "export_states": {
                    "type": "boolean",
                    "description": "Export visited states with component indices (states.csv). Requires state_component_dictionary.csv for decoding. Default: true",
                    "default": true,
                    "examples": [
                        true,
                        false
                    ]
                },
                "export_simulation": {
                    "type": "boolean",
                    "description": "Export simulation results in normalized indexed format (simulation.csv). Single file with schema: stage,series,variable_index,entity_id,value. Requires variable_dictionary.csv for decoding. Default: true",
                    "default": true,
                    "examples": [
                        true,
                        false
                    ]
                },
                "export_forward_detail": {
                    "type": "boolean",
                    "description": "Export forward pass trajectory details with variable indices (forward_detail.csv). Large files for detailed analysis. Default: false",
                    "default": false,
                    "examples": [
                        true,
                        false
                    ]
                },
                "export_backward_detail": {
                    "type": "boolean",
                    "description": "Export backward pass branching details with variable indices (backward_detail.csv). Large files for detailed analysis. Default: false",
                    "default": false,
                    "examples": [
                        true,
                        false
                    ]
                },
                "export_training_noises": {
                    "type": "boolean",
                    "description": "Export sampled noises from scenario tree with variable indices (training_sampled_noises.csv/parquet). Schema: stage_index,branching_index,variable_index,entity_id,value. Default: false",
                    "default": false,
                    "examples": [
                        true,
                        false
                    ]
                }
            },
            "additionalProperties": false
        },
        "logging": {
            "type": "object",
            "description": "Logging system configuration. Controls output verbosity, format, and destinations. See docs/guides/LOGGING-GUIDE.md for details.",
            "properties": {
                "level": {
                    "type": "string",
                    "description": "Minimum log level to display. ERROR=critical only, WARN=warnings+, INFO=operational (default), DEBUG=detailed, TRACE=very detailed",
                    "enum": [
                        "error",
                        "warn",
                        "info",
                        "debug",
                        "trace"
                    ],
                    "default": "info",
                    "examples": [
                        "info",
                        "debug",
                        "error"
                    ]
                },
                "format": {
                    "type": "string",
                    "description": "Output format. TERMINAL=human-readable ASCII tables with colors, JSON=machine-readable JSON Lines, STRUCTURED=terminal without colors",
                    "enum": [
                        "terminal",
                        "json",
                        "structured"
                    ],
                    "default": "terminal",
                    "examples": [
                        "terminal",
                        "json",
                        "structured"
                    ]
                },
                "outputs": {
                    "type": "array",
                    "description": "List of output destinations. Can write to multiple targets simultaneously (e.g., terminal + file)",
                    "items": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": [
                                    "terminal",
                                    "file",
                                    "silent"
                                ],
                                "description": "Output type: TERMINAL=stdout, FILE=write to file, SILENT=no output (benchmarking)"
                            },
                            "path": {
                                "type": "string",
                                "description": "File path (required for type=file). Parent directories created automatically",
                                "examples": [
                                    "./logs/training.log",
                                    "/var/log/powers/production.jsonl"
                                ]
                            }
                        },
                        "required": [
                            "type"
                        ],
                        "allOf": [
                            {
                                "if": {
                                    "properties": {
                                        "type": {
                                            "const": "file"
                                        }
                                    }
                                },
                                "then": {
                                    "required": [
                                        "path"
                                    ]
                                }
                            }
                        ]
                    },
                    "default": [
                        {
                            "type": "terminal"
                        }
                    ],
                    "examples": [
                        [
                            {
                                "type": "terminal"
                            }
                        ],
                        [
                            {
                                "type": "file",
                                "path": "./logs/run.log"
                            }
                        ],
                        [
                            {
                                "type": "terminal"
                            },
                            {
                                "type": "file",
                                "path": "./logs/debug.jsonl"
                            }
                        ]
                    ]
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}