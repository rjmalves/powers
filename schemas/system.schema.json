{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/rjmalves/powers/schemas/system.schema.json",
    "title": "Power System Specification",
    "description": "Specification of the power system topology, buses, transmission lines, thermal generators, and hydro plants",
    "type": "object",
    "required": [
        "buses",
        "lines",
        "thermals",
        "hydros"
    ],
    "properties": {
        "buses": {
            "type": "array",
            "description": "Electrical buses in the system",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "deficit_cost"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Unique bus identifier (0-indexed, must form contiguous range 0..N-1)",
                        "minimum": 0
                    },
                    "deficit_cost": {
                        "type": "number",
                        "description": "Cost of unmet demand at this bus ($/MWh)",
                        "minimum": 0,
                        "examples": [
                            50.0,
                            1000.0,
                            5000.0
                        ]
                    }
                },
                "additionalProperties": false
            }
        },
        "lines": {
            "type": "array",
            "description": "Transmission lines connecting buses",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "source_bus_id",
                    "target_bus_id",
                    "direct_capacity",
                    "reverse_capacity",
                    "exchange_penalty"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Unique line identifier (0-indexed, must form contiguous range 0..N-1)",
                        "minimum": 0
                    },
                    "source_bus_id": {
                        "type": "integer",
                        "description": "ID of source bus (must exist in buses array)",
                        "minimum": 0
                    },
                    "target_bus_id": {
                        "type": "integer",
                        "description": "ID of target bus (must exist in buses array)",
                        "minimum": 0
                    },
                    "direct_capacity": {
                        "type": "number",
                        "description": "Maximum power flow from source to target (MW)",
                        "minimum": 0
                    },
                    "reverse_capacity": {
                        "type": "number",
                        "description": "Maximum power flow from target to source (MW)",
                        "minimum": 0
                    },
                    "exchange_penalty": {
                        "type": "number",
                        "description": "Penalty cost for power exchange between buses ($/MWh)",
                        "minimum": 0
                    }
                },
                "additionalProperties": false
            }
        },
        "thermals": {
            "type": "array",
            "description": "Thermal generation units",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "bus_id",
                    "cost",
                    "min_generation",
                    "max_generation"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Unique thermal unit identifier (0-indexed, must form contiguous range 0..N-1)",
                        "minimum": 0
                    },
                    "bus_id": {
                        "type": "integer",
                        "description": "ID of bus where thermal unit is connected (must exist in buses array)",
                        "minimum": 0
                    },
                    "cost": {
                        "type": "number",
                        "description": "Generation cost ($/MWh)",
                        "minimum": 0
                    },
                    "min_generation": {
                        "type": "number",
                        "description": "Minimum generation capacity (MW)",
                        "minimum": 0
                    },
                    "max_generation": {
                        "type": "number",
                        "description": "Maximum generation capacity (MW)",
                        "minimum": 0
                    }
                },
                "additionalProperties": false
            }
        },
        "hydros": {
            "type": "array",
            "description": "Hydroelectric plants with reservoirs",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "downstream_hydro_id",
                    "bus_id",
                    "productivity",
                    "min_storage",
                    "max_storage",
                    "min_turbined_flow",
                    "max_turbined_flow",
                    "spillage_penalty"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Unique hydro plant identifier (0-indexed, must form contiguous range 0..N-1)",
                        "minimum": 0
                    },
                    "downstream_hydro_id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "ID of downstream hydro plant for cascade modeling (null if no downstream, must not create cycles)",
                        "minimum": 0
                    },
                    "bus_id": {
                        "type": "integer",
                        "description": "ID of bus where hydro plant is connected (must exist in buses array)",
                        "minimum": 0
                    },
                    "productivity": {
                        "type": "number",
                        "description": "Water-to-power conversion factor (MW per unit flow)",
                        "exclusiveMinimum": 0
                    },
                    "min_storage": {
                        "type": "number",
                        "description": "Minimum reservoir storage (volume units)",
                        "minimum": 0
                    },
                    "max_storage": {
                        "type": "number",
                        "description": "Maximum reservoir storage (volume units)",
                        "minimum": 0
                    },
                    "min_turbined_flow": {
                        "type": "number",
                        "description": "Minimum turbined water flow (volume/time units)",
                        "minimum": 0
                    },
                    "max_turbined_flow": {
                        "type": "number",
                        "description": "Maximum turbined water flow (volume/time units)",
                        "minimum": 0
                    },
                    "spillage_penalty": {
                        "type": "number",
                        "description": "Cost penalty for water spillage ($/unit)",
                        "minimum": 0
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "$comment": "PAR (Periodic Autoregressive) configuration is specified in recourse.json under noise_models[] with temporal_model.type='periodic_ar', not in system.json. Each hydro can have its own PAR model via noise_models filtered by entity_id (hydro_id)."
}