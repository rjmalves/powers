{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/rjmalves/powers/schemas/recourse.schema.json",
    "title": "SDDP Recourse and Uncertainty Specification",
    "description": "Specification of initial conditions and uncertainty distributions for stochastic SDDP",
    "type": "object",
    "required": [
        "initial_condition"
    ],
    "properties": {
        "initial_condition": {
            "type": "object",
            "description": "Initial state of the system at the beginning of the planning horizon",
            "required": [
                "storage",
                "inflow"
            ],
            "properties": {
                "storage": {
                    "type": "array",
                    "description": "Initial reservoir storage levels for each hydro plant",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "hydro_id",
                            "value"
                        ],
                        "properties": {
                            "hydro_id": {
                                "type": "integer",
                                "description": "ID of hydro plant (must exist in system.json, must form contiguous range 0..N-1)",
                                "minimum": 0
                            },
                            "value": {
                                "type": "number",
                                "description": "Initial storage value (must be within [min_storage, max_storage] from system.json)",
                                "minimum": 0
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "inflow": {
                    "type": "array",
                    "description": "Historical inflow lag values for AR model initialization. For AR(p) models, each hydro must have p entries with lag=1..p. Independent noise models can leave this empty.",
                    "items": {
                        "type": "object",
                        "required": [
                            "hydro_id",
                            "lag",
                            "value"
                        ],
                        "properties": {
                            "hydro_id": {
                                "type": "integer",
                                "description": "ID of hydro plant (must exist in system.json)",
                                "minimum": 0
                            },
                            "lag": {
                                "type": "integer",
                                "description": "Lag index (1 = t-1, 2 = t-2, ..., p = t-p for AR(p) model)",
                                "minimum": 1,
                                "maximum": 3
                            },
                            "value": {
                                "type": "number",
                                "description": "Historical inflow value at this lag (must be non-negative)",
                                "minimum": 0
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "noise_models": {
            "type": "array",
            "description": "Noise model specifications. Supports independent, autoregressive (AR), and periodic autoregressive (PAR) processes.",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "uncertainty_type",
                    "entity_id",
                    "season_id",
                    "marginal_distribution",
                    "temporal_model"
                ],
                "properties": {
                    "uncertainty_type": {
                        "type": "string",
                        "description": "Type of uncertainty (inflow or load)",
                        "enum": [
                            "inflow",
                            "load"
                        ]
                    },
                    "entity_id": {
                        "type": "integer",
                        "description": "Entity ID (must exist in system.json). For inflow: matches hydro_id. For load: matches bus_id.",
                        "minimum": 0
                    },
                    "season_id": {
                        "type": "integer",
                        "description": "Season ID where this noise model applies. Must match a season_id present in graph nodes. The noise model will apply to all nodes in this season.",
                        "minimum": 0
                    },
                    "marginal_distribution": {
                        "$ref": "#/definitions/MarginalDistribution",
                        "description": "Distribution for final series (Independent) or innovations (Autoregressive). **Ignored for periodic_ar** - use residual_distribution instead."
                    },
                    "innovation_distribution": {
                        "$ref": "#/definitions/InnovationDistribution",
                        "description": "Optional innovation distribution for stationary AR models. Not used for Independent or PeriodicAutoregressive."
                    },
                    "temporal_model": {
                        "$ref": "#/definitions/TemporalModel",
                        "description": "Temporal correlation model (independent, autoregressive, or periodic_ar)"
                    },
                    "residual_distribution": {
                        "$ref": "#/definitions/MarginalDistribution",
                        "description": "Distribution applied to de-seasonalized residuals aₜ in PAR models (CEPEL). **Required** for periodic_ar, **must be null** for independent/autoregressive."
                    }
                },
                "additionalProperties": false
            }
        },
        "correlation": {
            "type": "object",
            "description": "Correlation specification for multi-variate scenario generation. Enables realistic spatial/physical correlations (e.g., upstream/downstream hydro correlation, regional load correlation). Uses Gaussian copula with Cholesky decomposition.",
            "required": [
                "method",
                "blocks"
            ],
            "properties": {
                "method": {
                    "type": "string",
                    "enum": [
                        "none",
                        "cholesky"
                    ],
                    "description": "Correlation method. 'none': independent sampling (backward compatible). 'cholesky': Gaussian copula with Cholesky decomposition (recommended for production)."
                },
                "blocks": {
                    "type": "array",
                    "description": "Correlation blocks. Each block defines correlation among a subset of uncertainties. Entities not in any block are independent.",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "entities",
                            "correlation_matrix"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Block name for documentation and error messages.",
                                "examples": [
                                    "cascade_correlation",
                                    "regional_loads"
                                ]
                            },
                            "entities": {
                                "type": "array",
                                "description": "Entities in this correlation block. Order must match row/column order in correlation_matrix.",
                                "minItems": 2,
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "uncertainty_type",
                                        "entity_id"
                                    ],
                                    "properties": {
                                        "uncertainty_type": {
                                            "type": "string",
                                            "enum": [
                                                "inflow",
                                                "load"
                                            ],
                                            "description": "Type of uncertainty."
                                        },
                                        "entity_id": {
                                            "type": "integer",
                                            "minimum": 0,
                                            "description": "Entity ID (zero-based index)."
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "correlation_matrix": {
                                "type": "array",
                                "description": "Correlation matrix (symmetric, positive semi-definite, diagonal=1, off-diagonal in [-1,1]). Must be n×n where n=entities.length.",
                                "items": {
                                    "type": "array",
                                    "items": {
                                        "type": "number",
                                        "minimum": -1,
                                        "maximum": 1
                                    }
                                },
                                "examples": [
                                    [
                                        [
                                            1.0,
                                            0.8
                                        ],
                                        [
                                            0.8,
                                            1.0
                                        ]
                                    ],
                                    [
                                        [
                                            1.0,
                                            0.7,
                                            0.5
                                        ],
                                        [
                                            0.7,
                                            1.0,
                                            0.6
                                        ],
                                        [
                                            0.5,
                                            0.6,
                                            1.0
                                        ]
                                    ]
                                ]
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "definitions": {
        "MarginalDistribution": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["type", "mean", "std_dev"],
                    "properties": {
                        "type": { "const": "normal" },
                        "mean": {
                            "type": "number",
                            "description": "Mean μ of Normal(μ, σ²)"
                        },
                        "std_dev": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "description": "Standard deviation σ > 0"
                        }
                    },
                    "additionalProperties": false,
                    "description": "Normal distribution N(μ, σ²)"
                },
                {
                    "type": "object",
                    "required": ["type", "gamma", "mu", "sigma"],
                    "properties": {
                        "type": { "const": "lognormal3" },
                        "gamma": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Location parameter γ ≥ 0 (minimum value). Use γ=0 for 2-parameter lognormal. Recommended: γ ≥ 1 for inflows."
                        },
                        "mu": {
                            "type": "number",
                            "description": "Mean μ of log(X - γ). Controls central tendency of transformed variable."
                        },
                        "sigma": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "description": "Standard deviation σ > 0 of log(X - γ). Controls spread."
                        }
                    },
                    "additionalProperties": false,
                    "description": "3-parameter lognormal: X = γ + exp(μ + σZ) where Z ~ N(0,1). Guarantees X ≥ γ. Recommended for non-negative physical quantities."
                }
            ]
        },
        "InnovationDistribution": {
            "type": "object",
            "required": ["mean", "std_dev"],
            "properties": {
                "mean": {
                    "type": "number",
                    "description": "Mean of innovation white noise (typically 0.0)",
                    "default": 0.0
                },
                "std_dev": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Standard deviation of innovation white noise σ > 0"
                }
            },
            "additionalProperties": false,
            "description": "Innovation distribution for AR models (white noise εₜ)"
        },
        "TemporalModel": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                        "type": { "const": "independent" }
                    },
                    "additionalProperties": false,
                    "description": "Independent noise (no temporal correlation). Realizations Xₜ ~ F are independent across time."
                },
                {
                    "type": "object",
                    "required": ["type", "lag_order", "coefficients"],
                    "properties": {
                        "type": { "const": "autoregressive" },
                        "lag_order": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12,
                            "description": "AR order p (1 for AR(1), 2 for AR(2), etc.)"
                        },
                        "coefficients": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 12,
                            "items": { "type": "number" },
                            "description": "AR coefficients [φ₁, φ₂, ..., φₚ]. Must satisfy stationarity: |φ| < 1 for AR(1), spectral radius < 1 for AR(p)."
                        }
                    },
                    "additionalProperties": false,
                    "description": "Autoregressive AR(p): Xₜ = Σφᵢ·Xₜ₋ᵢ + εₜ where εₜ ~ innovation_distribution"
                },
                {
                    "type": "object",
                    "required": ["type", "period", "ar_orders", "ar_coefficients", "seasonal_means", "seasonal_stds"],
                    "properties": {
                        "type": { "const": "periodic_ar" },
                        "period": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 52,
                            "description": "Seasonal period (e.g., 12 for monthly, 4 for quarterly). Maps to season_id values in graph nodes. All seasonal arrays must have this length.",
                            "examples": [12, 4, 52]
                        },
                        "ar_orders": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 12,
                                "description": "AR order pₘ for period m (can vary by season)"
                            },
                            "description": "AR order for each period [p₀, p₁, ..., p_{period-1}]. Length must equal 'period'. Example: [1, 1, 2, 1, ...] for PAR with varying orders."
                        },
                        "ar_coefficients": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "array",
                                "items": { "type": "number" },
                                "description": "AR coefficients for one period [φ₁ₘ, φ₂ₘ, ..., φₚₘ]"
                            },
                            "description": "AR coefficients for each period. Outer array length = period, inner array[m] length = ar_orders[m]. Example: [[0.7], [0.75], [0.6, 0.2]] for AR(1), AR(1), AR(2)."
                        },
                        "seasonal_means": {
                            "type": "array",
                            "minItems": 1,
                            "items": { "type": "number" },
                            "description": "Seasonal mean μₘ for each period (e.g., [100, 120, 150, ...] for inflows). Length = period."
                        },
                        "seasonal_stds": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "number",
                                "exclusiveMinimum": 0
                            },
                            "description": "Seasonal standard deviation σₘ for each period (e.g., [20, 25, 30, ...]). Must be positive. Length = period."
                        }
                    },
                    "additionalProperties": false,
                    "description": "Periodic Autoregressive PAR(p) model (CEPEL). AR parameters vary by season: Zₜ = μₘ + σₘ·[Σφₖₘ·aₜ₋ₖ + aₜ] where m = season_id. See PAR_MODEL_SUPPORT.md for details."
                }
            ]
        }
    }
}