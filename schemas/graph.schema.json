{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/rjmalves/powers/schemas/graph.schema.json",
    "title": "SDDP Scenario Tree Graph",
    "description": "Specification of the multistage stochastic scenario tree with nodes and edges",
    "type": "object",
    "required": [
        "nodes",
        "edges"
    ],
    "properties": {
        "nodes": {
            "type": "array",
            "description": "Nodes in the scenario tree, representing decision stages",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "stage_id",
                    "season_id",
                    "start_date",
                    "end_date",
                    "risk_measure",
                    "load_stochastic_process",
                    "inflow_stochastic_process",
                    "state_variables"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Unique node identifier (0-indexed, must be unique across all nodes)",
                        "minimum": 0
                    },
                    "stage_id": {
                        "type": "integer",
                        "description": "Stage identifier (0-indexed, typically sequential from 0)",
                        "minimum": 0
                    },
                    "season_id": {
                        "type": "integer",
                        "description": "Season identifier for matching uncertainty distributions in recourse.json",
                        "minimum": 0
                    },
                    "start_date": {
                        "type": "string",
                        "description": "Stage start date/time in ISO 8601 format",
                        "format": "date-time",
                        "examples": [
                            "2024-01-01T00:00:00Z",
                            "2024-02-01T00:00:00Z"
                        ]
                    },
                    "end_date": {
                        "type": "string",
                        "description": "Stage end date/time in ISO 8601 format (must be after start_date)",
                        "format": "date-time",
                        "examples": [
                            "2024-02-01T00:00:00Z",
                            "2024-03-01T00:00:00Z"
                        ]
                    },
                    "risk_measure": {
                        "type": "string",
                        "description": "Risk measure for this stage",
                        "enum": [
                            "expectation",
                            "cvar",
                            "worstcase"
                        ],
                        "examples": [
                            "expectation"
                        ]
                    },
                    "load_stochastic_process": {
                        "type": "string",
                        "description": "Type of stochastic process for load uncertainty",
                        "enum": [
                            "naive"
                        ],
                        "examples": [
                            "naive"
                        ]
                    },
                    "inflow_stochastic_process": {
                        "type": "string",
                        "description": "Type of stochastic process for inflow uncertainty",
                        "enum": [
                            "naive"
                        ],
                        "examples": [
                            "naive"
                        ]
                    },
                    "state_variables": {
                        "type": "string",
                        "description": "State variables tracked between stages",
                        "enum": [
                            "storage"
                        ],
                        "examples": [
                            "storage"
                        ]
                    }
                },
                "additionalProperties": false
            }
        },
        "edges": {
            "type": "array",
            "description": "Edges connecting nodes in the scenario tree",
            "items": {
                "type": "object",
                "required": [
                    "source_id",
                    "target_id",
                    "probability",
                    "discount_rate"
                ],
                "properties": {
                    "source_id": {
                        "type": "integer",
                        "description": "ID of source node (must exist in nodes array)",
                        "minimum": 0
                    },
                    "target_id": {
                        "type": "integer",
                        "description": "ID of target node (must exist in nodes array)",
                        "minimum": 0
                    },
                    "probability": {
                        "type": "number",
                        "description": "Transition probability (sum of outgoing edges from each source must equal 1.0)",
                        "exclusiveMinimum": 0,
                        "maximum": 1.0,
                        "examples": [
                            0.5,
                            1.0
                        ]
                    },
                    "discount_rate": {
                        "type": "number",
                        "description": "Discount rate for cost-to-go calculation",
                        "minimum": 0,
                        "examples": [
                            0.0,
                            0.05,
                            0.1
                        ]
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}